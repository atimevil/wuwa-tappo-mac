{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wuwa Tappo",
  "version": "1.0.0",
  "identifier": "io.github.atimevil.wuwatappo-mac",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["wuwa-buddy"]
      }
    }
  }
}
